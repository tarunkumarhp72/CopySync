{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "frontend/tailwind.config.ts",
    "css": "frontend/src/app/globals.css",
    "baseColor": "neutral",
