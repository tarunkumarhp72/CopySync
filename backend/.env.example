DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipsync_local_db
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
APP_JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
CLIPBOARD_SIZE_LIMIT_BYTES=65536
MAX_IMAGE_UPLOAD_BYTES=5242880
UPLOAD_DIR=uploads
MAX_NOTE_HTML_BYTES=1048576
ACCOUNT_NOTE_LIMIT=50
GUEST_NOTE_LIMIT=10
IMAGES_PER_NOTE_LIMIT=5
ACCOUNT_IMAGE_STORAGE_BYTES=262144000
GUEST_IMAGE_STORAGE_BYTES=52428800
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=localhost
RATE_LIMIT_BACKEND=memory
GUEST_SESSION_TTL_SECONDS=3600
QR_TOKEN_TTL_SECONDS=300
GUEST_RECONNECT_GRACE_SECONDS=60
CONNECTION_MANAGER_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
DEBUG=true
