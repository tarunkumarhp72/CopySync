COPYSYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipsync_local_db
COPYSYNC_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
COPYSYNC_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
COPYSYNC_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
COPYSYNC_APP_JWT_SECRET=replace-with-a-long-random-secret
COPYSYNC_FRONTEND_URL=http://localhost:3000
COPYSYNC_BACKEND_CORS_ORIGINS=http://localhost:3000
COPYSYNC_CLIPBOARD_SIZE_LIMIT_BYTES=65536
COPYSYNC_MAX_IMAGE_UPLOAD_BYTES=5242880
COPYSYNC_UPLOAD_DIR=uploads
COPYSYNC_MAX_NOTE_HTML_BYTES=1048576
COPYSYNC_ACCOUNT_NOTE_LIMIT=50
COPYSYNC_GUEST_NOTE_LIMIT=10
COPYSYNC_IMAGES_PER_NOTE_LIMIT=5
COPYSYNC_ACCOUNT_IMAGE_STORAGE_BYTES=262144000
COPYSYNC_GUEST_IMAGE_STORAGE_BYTES=52428800
COPYSYNC_TURNSTILE_ENABLED=false
COPYSYNC_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
COPYSYNC_TURNSTILE_EXPECTED_HOSTNAME=localhost
COPYSYNC_RATE_LIMIT_BACKEND=memory
COPYSYNC_GUEST_SESSION_TTL_SECONDS=3600
COPYSYNC_QR_TOKEN_TTL_SECONDS=300
COPYSYNC_GUEST_RECONNECT_GRACE_SECONDS=60
COPYSYNC_CONNECTION_MANAGER_BACKEND=memory
COPYSYNC_REDIS_URL=redis://localhost:6379/0
COPYSYNC_APP_ENV=development
COPYSYNC_DEBUG=true
